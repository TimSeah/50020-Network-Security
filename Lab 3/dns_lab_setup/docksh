#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: docksh node1|node2|node3|node4" >&2
    exit 2
}

[[ $# -eq 1 ]] || usage
case "$1" in
    node1|node2|node3|node4) ;;
    *) usage ;;
esac

if docker info >/dev/null 2>&1; then
    exec docker exec -it "$1" /bin/bash
fi

if command -v sudo >/dev/null 2>&1 && sudo docker info >/dev/null 2>&1; then
    exec sudo docker exec -it "$1" /bin/bash
fi

echo "Cannot access Docker. Start Docker or add your account to the docker group." >&2
exit 1
